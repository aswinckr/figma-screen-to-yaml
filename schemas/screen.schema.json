{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Screen interchange v2 (not an official renderer schema)",
  "type": "object",
  "required": [
    "meta",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "figmaNodeId"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "library": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "figmaFileKey": {
          "type": "string"
        },
        "figmaNodeId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "behavior": {
      "type": "object"
    }
  },
  "definitions": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "gap": {
          "type": "number",
          "minimum": 0
        },
        "padding": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "align": {
          "enum": [
            "start",
            "end",
            "center",
            "baseline"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "end",
            "center",
            "space-between"
          ]
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "box",
            "children"
          ],
          "additionalProperties": false,
          "properties": {
            "box": {
              "type": "object",
              "required": [
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "layout": {
                  "$ref": "#/definitions/layout"
                },
                "style": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "component",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "props": {
              "type": "object"
            },
            "slots": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/slot"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "slot": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slot"
          }
        },
        {
          "type": "object",
          "required": [
            "$component"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "props": {
              "type": "object"
            },
            "slots": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/slot"
              }
            },
            "$component": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$text"
          ],
          "additionalProperties": false,
          "properties": {
            "$text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$asset"
          ],
          "additionalProperties": false,
          "properties": {
            "$asset": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$state"
          ],
          "additionalProperties": false,
          "properties": {
            "$state": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$image"
          ],
          "additionalProperties": false,
          "properties": {
            "$image": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$icon"
          ],
          "additionalProperties": false,
          "properties": {
            "$icon": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}
