{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spacing audit snapshot v1 (not a renderer schema)",
  "type": "object",
  "required": [
    "meta",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "figmaNodeId",
        "profile",
        "schemaVersion",
        "units"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "library": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "figmaFileKey": {
          "type": "string"
        },
        "figmaNodeId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "profile": {
          "const": "spacing"
        },
        "schemaVersion": {
          "const": 1
        },
        "units": {
          "const": "Figma px"
        }
      }
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "gap": {
          "type": "number",
          "minimum": 0
        },
        "padding": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "align": {
          "enum": [
            "start",
            "end",
            "center",
            "baseline"
          ]
        },
        "justify": {
          "enum": [
            "start",
            "end",
            "center",
            "space-between"
          ]
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "box",
            "children"
          ],
          "additionalProperties": false,
          "properties": {
            "box": {
              "type": "object",
              "required": [
                "id",
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "layout": {
                  "$ref": "#/definitions/layout"
                },
                "style": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "nodeId",
                    "name",
                    "type",
                    "parentId",
                    "childIndex",
                    "visible"
                  ],
                  "properties": {
                    "nodeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "parentId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "childIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "visible": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "component": {
                      "type": "object"
                    },
                    "mappedTarget": {
                      "type": "string"
                    },
                    "strokesIncludedInLayout": {
                      "type": "boolean"
                    },
                    "individualStrokeWeights": {
                      "type": "object"
                    },
                    "itemSpacing": {
                      "type": "number"
                    },
                    "strokeWeight": {
                      "type": "number"
                    },
                    "layoutGrow": {
                      "type": "number"
                    },
                    "strokeAlign": {
                      "type": "string"
                    },
                    "layoutSizingHorizontal": {
                      "type": "string"
                    },
                    "layoutSizingVertical": {
                      "type": "string"
                    },
                    "layoutAlign": {
                      "type": "string"
                    },
                    "layoutPositioning": {
                      "type": "string"
                    },
                    "scrollBehavior": {
                      "type": "string"
                    },
                    "overflowDirection": {
                      "type": "string"
                    }
                  }
                },
                "spacingTokens": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "value",
                      "bindingId",
                      "status"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "bindingId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "resolvedValue": {
                        "type": "number"
                      },
                      "status": {
                        "enum": [
                          "resolved",
                          "unresolved",
                          "mode-unverified",
                          "value-mismatch"
                        ]
                      },
                      "aliasChain": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "name",
                            "collectionId",
                            "modeId"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "collectionId": {
                              "type": "string"
                            },
                            "modeId": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "name": {
                        "type": "string"
                      },
                      "key": {
                        "type": "string"
                      },
                      "collection": {
                        "type": "string"
                      },
                      "modeId": {
                        "type": "string"
                      },
                      "mode": {
                        "type": "string"
                      },
                      "modeSource": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "slot": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slot"
          }
        },
        {
          "type": "object",
          "required": [
            "$component"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "preset": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "props": {
              "type": "object"
            },
            "slots": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/slot"
              }
            },
            "$component": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$text"
          ],
          "additionalProperties": false,
          "properties": {
            "$text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$asset"
          ],
          "additionalProperties": false,
          "properties": {
            "$asset": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$state"
          ],
          "additionalProperties": false,
          "properties": {
            "$state": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$image"
          ],
          "additionalProperties": false,
          "properties": {
            "$image": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "$icon"
          ],
          "additionalProperties": false,
          "properties": {
            "$icon": {
              "type": "object"
            }
          }
        }
      ]
    }
  }
}
